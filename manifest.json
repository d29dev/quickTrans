
{
  "manifest_version": 3,
  "name": "Quick Translate",
  "version": "1.0.0",
  "description": "Quick Translate",
  "permissions": ["sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Side Panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "48.png"
  },
  "host_permissions": [
    "https://dd9olqht68i8r.cloudfront.net/*"
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Q",
        "mac": "Command+Q"
      },
      "description": "Open the side panel"
    }
  }
}
